# =============================================================================
# DoIT API — environment template.  Copy to `.env` and fill in real values.
# Every value here is a PLACEHOLDER. `src/config/env.ts` validates these at boot
# (Zod, fail-fast) — a missing/malformed required var aborts startup.
# Secrets must come from the PaaS secret store in prod, never this file.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
# Host/port the Fastify server binds to.
HOST=0.0.0.0
PORT=3000
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (PostgreSQL 16) ----------------------------------------------
# Matches docker-compose.yml below. Use a managed Postgres URL in prod.
DATABASE_URL=postgres://doit:doit@localhost:5432/doit

# --- Redis (Phase 1+; the app boots WITHOUT Redis in Phase 0) ---------------
# Leave unset/blank to run Phase 0 with no Redis. Set for WS fan-out / queues later.
REDIS_URL=

# --- Auth: our JWTs ---------------------------------------------------------
# ES256 key pair, PEM (PKCS#8 private / SPKI public). Generate with, e.g.:
#   openssl ecparam -genkey -name prime256v1 -noout -out ec_private.pem
#   openssl pkcs8 -topk8 -nocrypt -in ec_private.pem -out jwt_private_pkcs8.pem
#   openssl ec -in ec_private.pem -pubout -out jwt_public.pem
# Paste the FULL PEM, newlines escaped as \n on a single line, OR use a secret file.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ES256_PKCS8_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ES256_SPKI_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# Optional: a key id surfaced in the JWT header / JWKS rotation later.
JWT_KID=doit-es256-2026-06

# --- Sign in with Apple -----------------------------------------------------
# `aud` of the Apple identity token == your app's bundle id.
APPLE_BUNDLE_ID=com.example.doit
APPLE_TEAM_ID=ABCDE12345
# Used later (authorization_code exchange / S2S notifications). Placeholder for Phase 0.
APPLE_KEY_ID=REPLACE_APPLE_KEY_ID
APPLE_CLIENT_SECRET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_APPLE_AUTHKEY_P8_CONTENTS\n-----END PRIVATE KEY-----"
# DEV ONLY: when "true" AND NODE_ENV!=production, Apple token signature/claims are
# NOT verified — the token's `sub` is trusted as-is so you can test without Apple.
# Hard-disabled in production regardless of this value.
APPLE_STUB_VERIFICATION=false

# --- Anthropic (Phase 4; listed now so the secret slot exists) --------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- APNs (Phase 1+; placeholders) ------------------------------------------
APNS_KEY_ID=REPLACE_APNS_KEY_ID
APNS_TEAM_ID=ABCDE12345
APNS_BUNDLE_ID=com.example.doit
# Path to the .p8 AuthKey OR its escaped contents. Keep OUT of git.
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_APNS_AUTHKEY_P8_CONTENTS\n-----END PRIVATE KEY-----"
# sandbox | production
APNS_ENVIRONMENT=sandbox
